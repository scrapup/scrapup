@startuml
!include <C4/C4_Container>
title baseline-assessment - C4 Nivel 2 (Containers)

Person(dev, "Desenvolvedor", "Invoca indirectamente via agente; confirma classificacoes ambiguas e overrides")

System_Boundary(scrapup, "Plugin scrapup") {
    Container(baseline, "baseline-assessment", "Skill + shell scripts", "Orquestra readiness de ambiente, descobre infra, classifica projeto, verifica diff, persiste estado de baseline")
    Container(docker_skill, "enable-docker-server", "Skill + shell scripts", "Inicia Docker daemon via processo conhecido; retorna exit code")
    Container(node_skill, "setup-node-env", "Skill + shell scripts", "Detecta versao Node, nvm install/use, NPM_TOKEN, npm install")
    Container(forge, "scrapup-forge", "Skill orquestradora", "Invoca baseline no pre-execucao e ao fim de cada TF")
    Container(tdad, "test-driven-agentic-development", "Skill", "Consulta ultimo estado verde para calibrar ciclo IMPACT-VERIFY-CORRECT")
    Container(reviewer, "reviewer-testing", "Agent", "Consulta estado do baseline para calibrar critique de testes")
    Container(mimic, "mimic-loop", "Skill", "Delega verificacao incremental ao fim de cada iteracao quando aplicavel")
}

System_Ext(project, "Projeto Node/TS", "package.json, configs, node_modules, codigo-fonte e testes")
System_Ext(saga, "mcp-saga", "Estado persistente do ecossistema (colecao test-config)")
System_Ext(docker, "Docker daemon", "Servicos de apoio quando o projeto depende de containers")

Rel(dev, forge, "Solicita execucao de TF/US")
Rel(forge, baseline, "Invoca assess no pre-execucao e verify-diff ao fim de cada TF")
Rel(tdad, baseline, "Consulta report para confirmar estado verde antes de SUBMIT")
Rel(reviewer, baseline, "Consulta report para calibrar severidade dos findings")
Rel(mimic, baseline, "Invoca verify-diff ao fim de iteracoes significativas")

Rel(baseline, docker_skill, "Delega verificacao/start do Docker daemon no assess")
Rel(baseline, node_skill, "Delega deteccao de Node, nvm, NPM_TOKEN e npm install no assess")
Rel(baseline, project, "Le manifestos e configs; executa runners em modo seco ou completo")
Rel(baseline, saga, "Persiste e consulta estado (test-config:{repo})")

Rel(docker_skill, docker, "Inicia via processo canonico quando offline")
Rel(node_skill, project, "Le .nvmrc, Dockerfile, package.json; executa nvm e npm")

LAYOUT_WITH_LEGEND()
@enduml
