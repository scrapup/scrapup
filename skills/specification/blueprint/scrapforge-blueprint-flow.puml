@startuml blueprint-flow
title Fluxo Spec-Driven Development (SDD) — Ciclo Completo

<style>
  diamond {
    BackgroundColor #FFFDE7
    LineColor #F9A825
  }
</style>

start

partition "0. Ponto de Entrada" #ECEFF1 {
  :nova demanda recebida;

  if (artefatos SDD\nexistem no workspace?\n(tasks.md, single-tasks.md,\nspec.md, plan.md)) then (sim)
    :usar artefatos existentes;
    #C8E6C9:pular para **Triagem**;
  else (não)
    #F3E5F5:sem artefatos SDD —\niniciar **Produção de Artefatos**;
  endif
}

partition "1. Produção de Artefatos (sem SDD prévio)" #F3E5F5 {
  :explorar intenção e escopo\ncom o utilizador\n(skill **brainstorming**);

  :analisar workspace:\ncódigo, configs, schemas,\nrotas, módulos, testes;

  :ciclo_refinamento = 0;

  repeat
    if (informações\nsuficientes?) then (sim)
    else (não)
      :listar 3–5 perguntas\nobjetivas ao utilizador; <<#FFF9C4>>
      :aguardar resposta;
    endif
    :ciclo_refinamento++;
  repeat while (informações insuficientes\nE ciclo <= 20?) is (continuar) not (encerrar)

  if (ciclo > 20\nE informação ainda\ninsuficiente?) then (sim)
    #FFCDD2:informar utilizador:\ninformação insuficiente\npara gerar artefatos;
    stop
  else (não)
  endif
}

partition "2. Triagem de Impacto" #E3F2FD {
  if (impacto baixo,\npoucos ficheiros,\n<= 5 Tarefas?) then (sim)
    #C8E6C9:fluxo **incremental**\n(single-tasks.md);
  else (não\nou > 5 TF)
    #E8EAF6:fluxo **completo**\n(spec → plan → tasks.md);
  endif
}

if (fluxo?) then (incremental)

partition "3i. Fluxo Incremental — single-tasks.md" #E8F5E9 {
  :confirmar enquadramento:\nbaixo impacto, poucos ficheiros,\nmáximo 5 TF;

  :discovery mínimo:\nesclarecer apenas\ndúvidas bloqueantes; <<#FFF9C4>>

  if (single-tasks.md\njá existe?) then (sim)
    :registar nova TF\ncom ID sequencial;
  else (não)
    :criar single-tasks.md\n(templates US + TF;\nespecificação nas TF;\nsem spec.md / plan.md);
  endif

  :redigir cada TF **auto-contida**:\nficheiros tocados, critérios,\nDoD, Orientação de Execução;

  :diagramas PlantUML\napenas se necessários\n(reduzir ambiguidade);

  if (contar blocos\nTF- > 5?) then (sim)
    #FFCDD2:excede limite incremental!\nExigir **fluxo completo**\n(spec + plan + tasks.md);
    stop
  else (não)
  endif

  :apresentar single-tasks.md\nao utilizador; <<#FFF9C4>>

  repeat
    if (utilizador\naprova?) then (sim)
    else (não)
      :revisar conforme feedback;
    endif
  repeat while (não aprovado?) is (sim) not (aprovado)

  #C8E6C9:single-tasks.md aprovado;
}

else (completo)

partition "3c-1. Fase 1 — spec.md (O Quê e Porquê)" #E8EAF6 {
  note right
    **Foco:** intenção de negócio.
    **PROIBIDO:** mencionar bancos,
    linguagens, frameworks ou bibliotecas.
    Tecnologia pertence à Fase 2.
  end note

  if (informações suficientes\npara todas as secções?) then (sim)
  else (não)
    :perguntar 3–5 questões\nobjetivas ao utilizador\n(casos de borda, regras de\nnegócio, SLAs, volumetria); <<#FFF9C4>>
    :aguardar resposta;
  endif

  :preencher template spec.md:\n— visão geral e objetivo\n— jornadas do utilizador\n— regras de negócio e restrições\n— casos de borda (Zero Trust)\n— critérios de sucesso e SLAs;

  :apresentar spec.md\nao utilizador; <<#FFF9C4>>

  repeat
    if (utilizador\naprova?) then (sim)
    else (não)
      :revisar conforme feedback;
    endif
  repeat while (spec.md\nnão aprovada?) is (sim) not (aprovada)

  #C8E6C9:spec.md aprovada;
}

partition "3c-2. Fase 2 — plan.md (O Como)" #FFF3E0 {
  :verificar pré-requisitos:\nspec.md aprovada,\nvolumetria e SLAs definidos;

  if (volumetria ou SLAs\nem falta?) then (sim)
    :perguntar ao utilizador\nantes de definir abordagem\nsíncrona vs assíncrona; <<#FFF9C4>>
  else (não)
  endif

  if (informações suficientes\npara arquitetura?) then (sim)
  else (não)
    :perguntar 3–5 questões\nsobre gargalos, integrações,\nrequisitos não-funcionais; <<#FFF9C4>>
    :aguardar resposta;
  endif

  :gerar diagramas PlantUML\n(skill **expert-plantuml**):\n— C4 N2 (Containers)\n— C4 N3 (Componentes)\n— Sequência (sucesso + falha)\n— Envelope/Rastreabilidade\n   (se houver fila);

  :preencher template plan.md:\n— visão geral da arquitetura\n— diagramas de solução\n— modelagem de dados e schemas\n— contratos IDL (OpenAPI/AsyncAPI)\n— resiliência e erros\n— métricas, logs e traces\n— justificativa e trade-offs;

  :apresentar plan.md\nao utilizador; <<#FFF9C4>>

  repeat
    if (utilizador\naprova?) then (sim)
    else (não)
      :revisar conforme feedback;
    endif
  repeat while (plan.md\nnão aprovado?) is (sim) not (aprovado)

  #C8E6C9:plan.md aprovado;
}

partition "3c-3. Fase 3 — tasks.md (Execução Atômica)" #FCE4EC {
  :verificar pré-requisitos:\nplan.md aprovado com\nDTOs e schemas definidos;

  :definir User Stories\n(entregáveis de valor);

  :incluir diagramas por US\n(C4 N2 + Sequência no mínimo)\nreutilizar/adaptar do plan.md\n(skill **expert-plantuml**);

  :sequenciar Tarefas\ntopologicamente\n(schemas/DB → conectores →\nusecases → controllers);

  :gerar cada Tarefa:\ntemplate completo com\nDoD e Orientação de Execução;

  :apresentar tasks.md\nao utilizador; <<#FFF9C4>>

  repeat
    if (utilizador\naprova?) then (sim)
    else (não)
      :revisar conforme feedback;
    endif
  repeat while (tasks.md\nnão aprovado?) is (sim) not (aprovado)

  #C8E6C9:tasks.md aprovado;
}

endif

partition "4. Artefatos Prontos" #C8E6C9 {
  :artefatos SDD aprovados\npelo utilizador;

  :pronto para implementação\n(skill **scrapup-forge**);
}

stop

legend right
  |= Cor |= Etapa |
  | <#ECEFF1> | 0. Ponto de Entrada |
  | <#F3E5F5> | 1. Produção de Artefatos |
  | <#E3F2FD> | 2. Triagem de Impacto |
  | <#E8F5E9> | 3i. Incremental (single-tasks.md) |
  | <#E8EAF6> | 3c-1. Fase 1 — spec.md |
  | <#FFF3E0> | 3c-2. Fase 2 — plan.md |
  | <#FCE4EC> | 3c-3. Fase 3 — tasks.md |
  | <#C8E6C9> | 4. Artefatos Prontos |
endlegend

@enduml
